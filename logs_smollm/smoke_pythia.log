# Window mode on Pythia-160M (GPT-NeoX; partial rotary: 8 of 32 planes per head rotate), second public model. Originally: SmolLM-135M with keys closer than 2048 tokens scored exactly as pretrained (continuous RoPE) and
# keys 2048+ tokens back scored by reset-RoPE + content address. Within 2048 tokens the model is the untouched model; no anneal.
# Far scores start with a per-head bias of -4 (learned). Trained with window 1024 on 2048-token FineWeb-Edu sequences so far keys exist
# (user 2026-10-28); evaluated with window 2048 so the deployed model is exact within its full pretrained context.
model_type = 'Jm'
delimiter_ids = (15, 964)           # Pythia tokenizer: '.' and ' .'
init_from = 'adapt'
adapt = False
adapt_ckpt = 'out-pythia-B/ckpt.pt'
adapt_zero_addr = True
window = 1024            # training window; evaluation uses --window 2048
grad_checkpoint = True
far_bias_init = -6.0   # Pythia: its attention scores are larger, -4 let far keys disturb the start by +0.28 nats; -6 by +0.06

out_dir = 'out-pythia-window-500'
eval_interval = 100
eval_iters = 20
log_interval = 10
eval_only = False
always_save_checkpoint = True
wandb_log = False

dataset = 'pythia_fineweb'
gradient_accumulation_steps = 8
batch_size = 1
block_size = 2048

dropout = 0.0
bias = False

learning_rate = 1e-4
max_iters = 500
weight_decay = 1e-1
beta1 = 0.9
beta2 = 0.95
grad_clip = 1.0

decay_lr = True
warmup_iters = 50
lr_decay_iters = 500
min_lr = 1e-5

compile = False

